{
  "name": "homelayer",
  "productName": "HomeLayer",
  "version": "1.0.0",
  "description": "A customizable Windows desktop layer for widgets and wallpapers.",
  "license": "MIT",
  "main": "./out/main/index.js",
  "author": "HomeLayer contributors",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "dist": "npm run build && electron-builder --win",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "run:widget": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-widget.ps1",
    "licenses": "node scripts/collect-licenses.mjs",
    "stop:widget": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Get-Process HomeLayer -ErrorAction SilentlyContinue | Stop-Process -Force\"",
    "phase1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/phase-1-manual-test.ps1 -Strategy auto -WidgetCount 1",
    "spike:wallpaper": "tsc scripts/spike-wallpaper.ts --outDir out/spike --rootDir scripts --module commonjs --target ES2022 --moduleResolution node --esModuleInterop --skipLibCheck --strict --noUncheckedIndexedAccess && electron out/spike/spike-wallpaper.js",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "koffi": "^3.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
